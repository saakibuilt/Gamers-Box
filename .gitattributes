# Auto detect text files and normalize line endings to LF
* text=auto

# Dart
*.dart text eol=lf
*.lock text eol=lf

# YAML
*.yaml text eol=lf
*.yml text eol=lf

# JSON
*.json text eol=lf

# Markdown
*.md text eol=lf
README.md merge=union

# Shell scripts
*.sh text eol=lf

# Gradle
*.gradle text eol=lf
gradle-wrapper.properties text eol=lf

# iOS
*.pbxproj text merge=union
*.plist text eol=lf
*.xcconfig text eol=lf

# Android
*.gradle text eol=lf
*.properties text eol=lf
*.xml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
